{
  "L": "sarvam/sarvam-105b",
  "I": {
    "memory": "sessions/fs-agent"
  },
  "A": {
    "name": "fs-agent",
    "version": "1.0.0",
    "intent": "You are a local filesystem assistant. You can read, list, and inspect files and directories safely using local MCP tools.",
    "maxSteps": 5
  },
  "T": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "tools": [
        "*"
      ]
    }
  },
  "E": {
    "SARVAM_API_KEY": "$SARVAM_API_KEY"
  }
}

