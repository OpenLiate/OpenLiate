{
  "L": "neon/gpt-5-4-nano",
  "I": {
    "memory": "sessions/neon-agent"
  },
  "A": {
    "name": "neon_agent",
    "version": "0.1.1",
    "intent": "Agent powered by Neon AI Gateway & Cloud Compute",
    "maxSteps": 5
  },
  "T": {
    "neon": {
      "name": "Neon",
      "transport": "http",
      "url": "https://mcp.neon.tech/mcp",
      "headers": {
        "Authorization": "Bearer $NEON_AI_GATEWAY_TOKEN"
      }
    }
  },
  "E": {
    "NEON_AI_GATEWAY_TOKEN": "$NEON_AI_GATEWAY_TOKEN",
    "NEON_AI_GATEWAY_BASE_URL": "$NEON_AI_GATEWAY_BASE_URL",
    "DATABASE_URL": "$DATABASE_URL"
  }
}

