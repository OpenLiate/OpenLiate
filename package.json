{
  "name": "openliate",
  "version": "0.1.0",
  "description": "Open Source Backend Layer for AI Agents — Built for Sovereign AI Agents From India to the World",
  "type": "module",
  "main": "./dist/liate.js",
  "types": "./src/liate.ts",
  "exports": {
    ".": {
      "types": "./src/liate.ts",
      "import": "./dist/liate.js"
    }
  },
  "bin": {
    "openliate": "dist/bin.js",
    "liate": "dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/liate.js",
    "dist/runtime",
    "src",
    "hub"
  ],
  "scripts": {
    "test": "bun test",
    "build": "bun run build:bin && bun run build:cli && bun run build:runtime && bun run build:hono && bun run build:wasm && bun run build:sdk",
    "build:bin": "bun build ./src/cli/index.ts --target node --format esm --outfile dist/bin.js",
    "build:cli": "bun build ./src/cli/index.ts --compile --outfile dist/cli/openliate && bun build ./src/cli/index.ts --compile --outfile dist/cli/liate",
    "build:runtime": "bun build ./src/cloud/runtime/hono.ts --target node --format esm --outfile dist/runtime/index.js",
    "build:sdk": "bun build ./src/liate.ts --target node --format esm --outfile dist/liate.js",
    "serve": "bun run dist/runtime/index.js",
    "typecheck": "tsc --noEmit",
    "benchmark": "bun run scripts/benchmark.ts",
    "build:hono": "bun build ./src/cloud/runtime/hono.ts --target bun --format esm --outfile dist/runtime/hono.js",
    "build:wasm": "bun build ./src/cloud/runtime/wasm.ts --target bun --format esm --outfile dist/runtime/wasm.js",
    "build:fastly:wasm": "bun build ./src/cloud/runtime/wasm.ts --target bun --format esm --outfile bin/index.js && js-compute-runtime bin/index.js bin/main.wasm"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@neon/ai-sdk-provider": "1.3.0",
    "@neon/config": "1.10.1",
    "@neon/env": "1.6.9",
    "@neondatabase/serverless": "1.2.0",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/sdk": "1.28.56",
    "ai": "7.0.162",
    "hono": "^4.7.0",
    "jszip": "3.10.2",
    "neon-new": "0.15.1",
    "sarvamai": "1.1.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fastly/js-compute": "4.1.0",
    "@fastly/mcp": "2.4.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "liate",
    "agent",
    "autonomous-agents",
    "sovereign-ai",
    "agent-platform",
    "runtime",
    "mcp",
    "sarvamai"
  ],
  "author": "Vinod Hatti (@gitdevinod)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openliate/openliate.git"
  },
  "bugs": {
    "url": "https://github.com/openliate/openliate/issues"
  },
  "homepage": "https://openliate.tech"
}
